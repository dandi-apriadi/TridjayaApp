<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
    <cache-path name="flyers" path="flyers/" />
    <cache-path name="absensi" path="absensi/" />
    <cache-path name="delivery" path="delivery/" />
    <cache-path name="raport" path="raport/" />
    <!-- APK update pindah ke files-path (2026-08-01): cache dibersihkan OS saat
         penyimpanan menipis, dan APK yang lenyap antara unduh & pasang gagal tanpa
         pesan yang berarti. `cache-path` LAMA sengaja dipertahankan supaya berkas
         sisa dari versi sebelumnya masih bisa dibuka, bukan melempar
         IllegalArgumentException. -->
    <files-path name="update" path="update/" />
    <cache-path name="update_lama" path="update/" />
    <cache-path name="aktivitas_chat" path="aktivitas-chat/" />
    <!-- Foto KTP prospek event: berkas SEMENTARA tempat kamera menulis sebelum
         dikompres & diunggah. Tanpa entri ini `FileProvider.getUriForFile` melempar
         IllegalArgumentException dan tombol Kamera mati total di lapangan. -->
    <cache-path name="event" path="event/" />
    <!-- Foto komplain (kwitansi, bukti kerja teknisi, bukti bayar, unit ditarik) —
         alasan sama dengan `event` di atas: tanpa entri ini kamera mati total. -->
    <cache-path name="home_service" path="home-service/" />
    <!-- Foto usulan pendaftaran SN dari lapangan (foto SN + foto barang), ditulis
         `OpnameDetailScreen.kt` ke `cacheDir/serial/`. KETIGA KALINYA jebakan yang
         sama menggigit setelah `event` dan `home_service` — dan yang ini paling
         parah gejalanya: `getUriForFile` di sana dipanggil DI DALAM `remember`,
         jadi ia melempar saat KOMPOSISI, bukan saat tombol kamera ditekan. App
         tutup begitu panel usulan dirender, sebelum petugas sempat menyentuh
         apa pun. Terbukti di produksi: `serial_registration_requests` NOL BARIS
         sejak fiturnya mendarat 2026-07-29 — tak seorang pun pernah berhasil
         mengusulkan. Dijaga `FileProviderPathsTest`. -->
    <cache-path name="serial" path="serial/" />
    <!-- Foto bukti pemasangan AC, ditulis `AcInstallScreen.kt` ke `cacheDir/ac-install/`.
         Alasannya sama dengan `event`, `home_service`, dan `serial` di atas — dan
         daftar itu sudah panjang justru karena entri ini gampang terlupa. Dijaga
         `FileProviderPathsTest`. -->
    <cache-path name="ac_install" path="ac-install/" />
    <!-- Slip gaji yang diekspor jadi PDF, ditulis `SlipGajiPdf.kt` ke
         `cacheDir/slip-gaji/`. Layar Slip Gaji memasang FLAG_SECURE (audit 3.4)
         sehingga screenshot diblokir — ekspor PDF inilah penggantinya, jadi
         entri yang hilang di sini mencabut satu-satunya cara karyawan menyimpan
         slipnya. Dijaga `FileProviderPathsTest`. -->
    <cache-path name="slip_gaji" path="slip-gaji/" />
    <!-- Foto bukti undangan Kupon Gebyar, ditulis `KuponGebyarScreen.kt` ke
         `cacheDir/kupon-gebyar/`. Alasannya sama dengan `event`, `home_service`,
         `serial`, dan `ac_install` di atas — dan panggilan `getUriForFile`-nya
         ada DI DALAM `remember`, jadi entri yang hilang menutup app saat layar
         DIBUKA, bukan saat tombol kamera ditekan (kelas kegagalan `serial`).
         Dijaga `FileProviderPathsTest`. -->
    <cache-path name="kupon_gebyar" path="kupon-gebyar/" />
    <!-- Salinan foto bukti pengajuan indent, ditulis `IndentCreateViewModel.kt` ke
         `cacheDir/indent/`. Layar ini TIDAK memanggil `getUriForFile` hari ini
         (berkasnya cuma dibaca sendiri), jadi entri ini bukan penangkal crash
         melainkan pemenuhan aturan `FileProviderPathsTest`: tiap subdirektori
         cache wajib dideklarasikan, supaya pemakaian FileProvider yang ditambah
         belakangan tak menemukan lubangnya. -->
    <cache-path name="indent" path="indent/" />
    <!-- Berkas keluaran sementara VideoTranscoder (util/VideoTranscoder.kt) — video bukti Input
         Aktivitas ditranscode ke sini SEBELUM diunggah, ditulis `AktivitasViewModel.kirimVideo`
         ke `cacheDir/media-compress/`. Layar ini tak memanggil `getUriForFile` atas berkas ini
         hari ini (upload langsung dari File via `asRequestBody`), jadi entri ini bukan penangkal
         crash melainkan pemenuhan aturan `FileProviderPathsTest`: tiap subdirektori cache wajib
         dideklarasikan, supaya pemakaian FileProvider yang ditambah belakangan tak menemukan
         lubangnya (pola sama `indent` di atas). -->
    <cache-path name="media_compress" path="media-compress/" />
</paths>
